# Create .gitignore file
@"
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/

# IDE
.vscode/
.idea/
*.swp

# Environment variables
.env
.env.local

# Logs
*.log

# Cache
*.cache
.cache/

# OS
.DS_Store
Thumbs.db

# Poetry/Pip
*.egg-info/
dist/
build/
"@ | Out-File -Encoding utf8 .gitignore